<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Stickmouse – Third-party licenses</title>
<style>
  body { font: 14px/1.5 -apple-system, system-ui, sans-serif; max-width: 760px; margin: 40px auto; padding: 0 16px; color: #222; }
  pre { white-space: pre-wrap; background: #f5f5f7; padding: 12px; border-radius: 8px; font-size: 12px; }
  @media (prefers-color-scheme: dark) { body { background: #1e1e1e; color: #ddd; } pre { background: #2a2a2a; } }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>Stickmouse is built with these open-source libraries. Thank you to their authors.</p>
{{#each licenses}}
<h2>{{name}}</h2>
<p>Used by: {{#each used_by}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/each}}</p>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
