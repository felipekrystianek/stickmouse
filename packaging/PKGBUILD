# Builds from this checkout: run `makepkg -si` in the packaging directory.
pkgname=stickmouse
pkgver=0.1.0
pkgrel=1
pkgdesc="Use an Xbox controller as a mouse and media remote on KDE Plasma"
arch=('x86_64')
license=('MIT')
depends=('gcc-libs' 'glibc' 'kconfig' 'libnotify' 'plasma-keyboard' 'plasma-workspace' 'qt6-tools' 'xdg-utils')
optdepends=('xpadneo-dkms: Bluetooth support, including holding the Xbox button')
makedepends=('rust')
# Stickmouse used to be called padcursor; these let pacman swap the old package out.
provides=('padcursor')
conflicts=('padcursor')
replaces=('padcursor')
install=stickmouse.install
options=('!debug')

build() {
    cargo build --release --locked \
        --manifest-path "$startdir/../Cargo.toml" \
        --target-dir "$srcdir/target"
}

check() {
    cargo test --release --locked \
        --manifest-path "$startdir/../Cargo.toml" \
        --target-dir "$srcdir/target"
}

package() {
    install -Dm755 "$srcdir/target/release/stickmouse" "$pkgdir/usr/bin/stickmouse"
    install -Dm644 "$startdir/stickmouse.service" "$pkgdir/usr/lib/systemd/user/stickmouse.service"
    install -Dm644 "$startdir/stickmouse-modprobe.conf" "$pkgdir/usr/lib/modprobe.d/stickmouse.conf"
}
