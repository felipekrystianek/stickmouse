post_install() {
    # Takes effect now, without reloading the driver. The modprobe file keeps it after a reboot.
    param=/sys/module/hid_xpadneo/parameters/disable_shift_mode
    [ -w "$param" ] && echo 1 > "$param"
    echo "Start padcursor now, and at every login, with:"
    echo "  systemctl --user daemon-reload && systemctl --user enable --now padcursor"
}

post_upgrade() {
    param=/sys/module/hid_xpadneo/parameters/disable_shift_mode
    [ -w "$param" ] && echo 1 > "$param"
    echo "Restart padcursor to use the new version:"
    echo "  systemctl --user daemon-reload && systemctl --user restart padcursor"
}

pre_remove() {
    param=/sys/module/hid_xpadneo/parameters/disable_shift_mode
    [ -w "$param" ] && echo 0 > "$param"
    echo "Stop padcursor if it is still running: systemctl --user disable --now padcursor"
}
